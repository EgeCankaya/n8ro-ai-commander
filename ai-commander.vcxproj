  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <PreBuildEvent>
      <Command>if "$(N8RO_RELEASE)"=="" (
  echo [Error] N8RO_RELEASE is not defined. Run dist\setup.cmd before opening/building.
  exit /b 1
)
if not exist "$(N8RO_RELEASE)\include\n8ro-core\plugin\IPlugin.h" (
  echo [Error] Missing SDK header: $(N8RO_RELEASE)\include\n8ro-core\plugin\IPlugin.h
  exit /b 1
)
if not exist "$(N8RO_RELEASE)\include\n8ro-sim\plugin\IScriptingPluginService.h" (
  echo [Error] Missing SDK header: $(N8RO_RELEASE)\include\n8ro-sim\plugin\IScriptingPluginService.h
  exit /b 1
)
if not exist "$(N8RO_RELEASE)\lib\n8ro-core.lib" (
  echo [Error] Missing SDK library: $(N8RO_RELEASE)\lib\n8ro-core.lib
  exit /b 1
)
if not exist "$(N8RO_RELEASE)\lib\n8ro-sim.lib" (
  echo [Error] Missing SDK library: $(N8RO_RELEASE)\lib\n8ro-sim.lib
  exit /b 1
)</Command>
    </PreBuildEvent>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>NDEBUG;WIN32_LEAN_AND_MEAN;NOMINMAX;N8RO_CORE_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(N8RO_RELEASE)\include\n8ro-core;$(N8RO_RELEASE)\include\n8ro-sim;$(N8RO_RELEASE)\include\n8ro-schema;$(N8RO_RELEASE)\include\n8ro-data;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(N8RO_RELEASE)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>n8ro-core.lib;n8ro-schema.lib;n8ro-data.lib;n8ro-sim.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>if "$(N8RO_RELEASE_USER_SIM_PLUGINS)"=="" (
  echo [Error] N8RO_RELEASE_USER_SIM_PLUGINS is not defined. Run dist\setup.cmd before building.
  exit /b 1
)
if not exist "$(N8RO_RELEASE_USER_SIM_PLUGINS)" (
  mkdir "$(N8RO_RELEASE_USER_SIM_PLUGINS)"
)
copy /Y "$(TargetPath)" "$(N8RO_RELEASE_USER_SIM_PLUGINS)\" >nul
if errorlevel 1 (
  echo [Error] Failed to deploy plugin DLL to $(N8RO_RELEASE_USER_SIM_PLUGINS)
  exit /b 1
)
echo [Deploy] ai-commander.dll copied to $(N8RO_RELEASE_USER_SIM_PLUGINS)
REM Seed the doctrine block. prompt.doctrinePath defaults to data\doctrine.txt, resolved against
REM the HOST's working directory - the release root - so a deployed plugin finds nothing there
REM unless it is put there. Copied ONLY IF ABSENT, deliberately: this file is edited by whoever
REM tunes tactics rather than whoever rebuilds the DLL, and clobbering their edits on every build
REM would be worse than not seeding it at all.
if not exist "$(N8RO_RELEASE)\data\doctrine.txt" (
  copy /Y "$(ProjectDir)data\doctrine.txt" "$(N8RO_RELEASE)\data\doctrine.txt" >nul
  if errorlevel 1 (
    echo [Warning] Could not seed doctrine.txt into $(N8RO_RELEASE)\data - order quality is degraded until it is placed there
  ) else (
    echo [Deploy] doctrine.txt seeded into $(N8RO_RELEASE)\data
  )
) else (
  echo [Deploy] doctrine.txt already present in $(N8RO_RELEASE)\data - left untouched
)</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
